{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trend-factory-console",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "console.nakake.com", "custom_domain": true }],
  // Access は console.nakake.com にしか掛からないので、掛からない入口は閉じておく
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trend-factory",
      // core/wrangler.jsonc と同じ値。`wrangler d1 create trend-factory` で出た id に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    // いずれも REPLACE-ME のままだと全リクエストが 503 になる(README の手順 3)
    "ACCESS_TEAM_DOMAIN": "REPLACE-ME.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE-ME",
    "ALLOWED_EMAIL": "REPLACE-ME",
    "PREVIEW_SUFFIX": "REPLACE-ME.workers.dev"
  }
}
