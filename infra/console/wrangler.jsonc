{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trend-factory-console",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "console.nakake.com", "custom_domain": true }],
  // Access は console.nakake.com にしか掛からないので、掛からない入口は閉じておく
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trend-factory",
      // core/wrangler.jsonc と同じ値にする
      "database_id": "57c530ff-3b1f-4551-aa49-6c1d7f5a5727"
    }
  ],
  "vars": {
    // core と同じ値。工房アカウントの workers.dev サブドメイン(例 "xxx.workers.dev")に置き換える
    "PREVIEW_SUFFIX": "REPLACE-ME.workers.dev"
  }
  // ACCESS_TEAM_DOMAIN / ACCESS_AUD / ALLOWED_EMAIL はここに書かない(公開リポジトリのため)。
  // `wrangler secret put` で入れる(README の手順 5)。未設定のあいだは全リクエストが 503
}
