{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trend-factory-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "trend-factory-api.nakake.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "triggers": { "crons": ["5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trend-factory",
      "database_id": "57c530ff-3b1f-4551-aa49-6c1d7f5a5727",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // 工房アカウント(プレビュー専用)の workers.dev サブドメイン
    "PREVIEW_SUFFIX": "trend-factory-preview.workers.dev"
  }
}
