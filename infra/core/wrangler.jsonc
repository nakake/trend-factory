{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trend-factory-core",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "agent.nakake.com", "custom_domain": true }],
  "triggers": { "crons": ["5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trend-factory",
      // `wrangler d1 create trend-factory` で出た id に置き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // 工房アカウントの workers.dev サブドメイン(例 "xxx.workers.dev")に置き換える
    "PREVIEW_SUFFIX": "REPLACE-ME.workers.dev"
  }
}
